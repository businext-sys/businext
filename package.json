{
  "name": "businext",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo de Businext: apps/web (Next.js), apps/mobile (Expo, en construccion) y packages/shared-core (logica y tipos compartidos).",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev:web": "pnpm --filter @businext/web dev",
    "build:web": "pnpm --filter @businext/web build",
    "lint:web": "pnpm --filter @businext/web lint",
    "type-check:web": "pnpm --filter @businext/web type-check",
    "test:shared-core": "pnpm --filter @businext/shared-core test",
    "type-check:shared-core": "pnpm --filter @businext/shared-core type-check"
  }
}
